<Application x:Class="MapDownloader.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MapDownloader"
             xmlns:cvt="clr-namespace:MapDownloader.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!--  全局转换器（各页面共用）  -->
            <cvt:BoolToVisibilityConverter x:Key="BoolToVis" />
            <cvt:BoolToVisibilityConverter x:Key="InverseBoolToVis" Inverse="True" />
            <cvt:EnvelopeConverter x:Key="EnvelopeCvt" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
