<Application x:Class="TileDownloader.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TileDownloader"
             xmlns:cvt="clr-namespace:TileDownloader.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!--  全局转换器（各页面共用）  -->
            <cvt:BoolToVisibilityConverter x:Key="BoolToVis" />
            <cvt:BoolToVisibilityConverter x:Key="InverseBoolToVis" Inverse="True" />
            <cvt:EnvelopeConverter x:Key="EnvelopeCvt" />

            <!-- 全局 TextBlock 前景色绑定，确保深色模式下所有文本默认使用白色/主文本色，绝不退化为系统默认黑色 -->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>
            <Style TargetType="ui:TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
