<UserControl x:Class="MapDownloader.Controls.MapPickControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MapDownloader.Controls" 
             xmlns:map="clr-namespace:MapControl;assembly=MapControl.WPF"

             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>

        <map:Map x:Name="map" MouseRightButtonDown="MapMouseRightButtonDown" MouseRightButtonUp="MapMouseRightButtonUp" MouseMove="MapMouseMove" >
            <map:Map.MapLayer>
                <map:MapTileLayer SourceName="OpenStreetMap" Description="© [OpenStreetMap contributors](http://www.openstreetmap.org/copyright)">
                    <map:MapTileLayer.TileSource>
                        <map:TileSource UriFormat="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"></map:TileSource>
                    </map:MapTileLayer.TileSource>
                </map:MapTileLayer>
            </map:Map.MapLayer>

            <map:MapPolygon x:Name="pick" Stroke="Red" StrokeThickness="3">
            </map:MapPolygon>
        </map:Map>
    </Grid>
</UserControl>
