<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>annotations</Nullable>
    <AssemblyName>TileDownloader</AssemblyName>
    <ApplicationIcon>Resources\logo.ico</ApplicationIcon>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>

    <!--  程序集元数据：项目仓库与版权信息（写入 exe 文件属性）  -->
    <Version>1.3.2</Version>
    <Authors>jinghongbo</Authors>
    <Product>地图瓦片下载器</Product>
    <Description>批量下载 XYZ 瓦片地图 · 支持多文件 pak / 单文件 pak / MBTiles / 瓦片目录输出</Description>
    <Copyright>Copyright © 2026 jinghongbo</Copyright>
    <RepositoryUrl>https://github.com/jinghongbo/TileDownloader</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <ItemGroup>
    <!--  测试项目位于同一目录下，主工程默认通配会把它编译进来，这里排除  -->
    <Compile Remove="TileDownloader.Tests\**" />
    <Page Remove="TileDownloader.Tests\**" />
    <Resource Remove="TileDownloader.Tests\**" />
    <EmbeddedResource Remove="TileDownloader.Tests\**" />
    <None Remove="TileDownloader.Tests\**" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Resources\logo.png" />
    <None Remove="Resources\logo.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="WPF-UI" Version="4.2.0" />
    <PackageReference Include="FreeSql.Provider.Sqlite" Version="3.5.311" />
    <PackageReference Include="BruTile" Version="6.0.0" />
    <PackageReference Include="NetTopologySuite" Version="2.6.0" />
    <PackageReference Include="ProjNet" Version="2.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Resources\logo.png" />
    <Resource Include="Resources\logo.ico" />
    <EmbeddedResource Include="Resources\regions.json" />
    <None Include="Resources\regions.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!--  源配置同时内嵌进程序集：单文件发布时 exe 自带全部地图源，不依赖 Sources 目录  -->
    <None Include="Sources\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Sources\**\*.json" LogicalName="TileDownloader.Sources.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
