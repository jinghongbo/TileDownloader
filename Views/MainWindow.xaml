<ui:FluentWindow
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:TileDownloader.Views"
    x:Class="TileDownloader.Views.MainWindow"
    Title="瓦片地图下载工具"
    Height="800" Width="1280"
    MinHeight="640" MinWidth="960"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    Icon="pack://application:,,,/Resources/logo.ico"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Margin" Value="0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="7,7,7,7" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  自绘标题栏（带应用图标、标题与最小化/最大化/关闭按钮）  -->
        <ui:TitleBar Grid.Row="0"
                     Title="瓦片地图下载工具"
                     Height="40"
                     Padding="6,0,0,0">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Resources/logo.png"
                              Width="22"
                              Height="22"
                              VerticalAlignment="Center"
                              Margin="6,0,8,0" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!--  WPF-UI 4.3 内建导航：TargetPageType 必填，页面实例由 SetServiceProvider 注入的容器提供  -->
        <ui:NavigationView x:Name="NavView"
                           Grid.Row="1"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="新建下载"
                                       TargetPageTag="NewDownload"
                                       TargetPageType="views:NewDownloadPage"
                                       IsActive="True">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Map24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="任务中心"
                                       TargetPageTag="Tasks"
                                       TargetPageType="views:TasksPage">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="ArrowDownload24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="设置"
                                       TargetPageTag="Settings"
                                       TargetPageType="views:SettingsPage">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <!--  Snackbar 提示宿主（覆盖于导航内容之上，靠右下角弹出）  -->
        <ui:SnackbarPresenter x:Name="SnackbarPresenter" Grid.Row="1" />

        <!--  ContentDialog 弹窗宿主  -->
        <ui:ContentDialogHost x:Name="RootDialogHost" Grid.Row="1" />
    </Grid>
</ui:FluentWindow>
