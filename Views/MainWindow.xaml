<ui:FluentWindow
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:TileDownloader.Views"
    x:Class="TileDownloader.Views.MainWindow"
    Title="通用瓦片地图下载工具"
    Height="800" Width="1280"
    MinHeight="640" MinWidth="960"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    Icon="/Resources/logo.png"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  自绘标题栏（含最小化/最大化/关闭按钮）；ExtendsContentIntoTitleBar=True 时需显式提供  -->
        <ui:TitleBar Grid.Row="0" Title="通用瓦片地图下载工具" />

        <!--  WPF-UI 4.3 内建导航：TargetPageType 必填（OnClick 仅在此属性非空时触发导航），
              页面实例由 SetServiceProvider 注入的容器提供  -->
        <ui:NavigationView x:Name="NavView"
                           Grid.Row="1"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="新建下载"
                                       TargetPageTag="NewDownload"
                                       TargetPageType="views:NewDownloadPage"
                                       IsActive="True">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Map24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="任务中心"
                                       TargetPageTag="Tasks"
                                       TargetPageType="views:TasksPage">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="ArrowDownload24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="设置"
                                       TargetPageTag="Settings"
                                       TargetPageType="views:SettingsPage">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>

        <!--  Snackbar 提示宿主（覆盖于导航内容之上，靠右下角弹出）  -->
        <ui:SnackbarPresenter x:Name="SnackbarPresenter" Grid.Row="1" />

        <!--  ContentDialog 弹窗宿主  -->
        <ui:ContentDialogHost x:Name="RootDialogHost" Grid.Row="1" />
    </Grid>
</ui:FluentWindow>
