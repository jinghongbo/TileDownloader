<Window
    x:Class="TileDownloader.Views.MapStyleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="地图样式"
    Width="820"
    Height="660"
    MinWidth="680"
    MinHeight="520"
    WindowStartupLocation="CenterOwner"
    Icon="pack://application:,,,/Resources/logo.ico"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    FontFamily="Microsoft YaHei UI">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  顶部：来源 + 示例选择  -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="来源：" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="SourceText" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="在这里粘贴或编辑样式文本"
                           Margin="12,0,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="示例" VerticalAlignment="Center" Margin="0,0,6,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ComboBox x:Name="PresetBox"
                          Width="150"
                          DisplayMemberPath="Name"
                          SelectionChanged="PresetBox_SelectionChanged" />
            </StackPanel>
        </Grid>

        <!--  左：我的样式；右：文本编辑  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    CornerRadius="8"
                    Padding="10"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="我的样式"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6" />

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <ui:TextBox x:Name="StyleNameBox"
                                    PlaceholderText="样式名"
                                    Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Content="保存" Click="Save_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            <ui:Button Grid.Column="2" Content="删除" Click="Delete_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                        </Grid>
                    </StackPanel>

                    <ListBox x:Name="SavedList"
                             DisplayMemberPath="Name"
                             SelectionChanged="SavedList_SelectionChanged"
                             BorderThickness="0"
                             Background="Transparent" />
                </DockPanel>
            </Border>

            <TextBox x:Name="Editor"
                     Grid.Column="2"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     FontFamily="Consolas"
                     FontSize="12"
                     Padding="8"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Background="{DynamicResource ControlFillColorDefaultBrush}"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                     BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" />
        </Grid>

        <!--  校验状态  -->
        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Margin="0,8,0,0"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <!--  底部操作区  -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:Button Grid.Column="0" Content="校验" Click="Validate_Click" Margin="0,0,6,0" />
            <ui:Button Grid.Column="1" Content="粘贴" Click="Paste_Click" Margin="0,0,6,0" />
            <ui:Button Grid.Column="2" Content="复制" Click="Copy_Click" Margin="0,0,6,0" />

            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <ComboBox x:Name="ScenarioBox" Width="96" SelectedIndex="0" Margin="0,0,6,0">
                    <ComboBoxItem Content="深色" />
                    <ComboBoxItem Content="浅色" />
                    <ComboBoxItem Content="高对比" />
                </ComboBox>
                <ui:Button Content="复制 AI 提示词" Click="CopyPrompt_Click" />
            </StackPanel>

            <ui:Button Grid.Column="5" Content="取消" Click="Cancel_Click" MinWidth="84" Margin="0,0,8,0" />
            <ui:Button Grid.Column="6" Content="应用" Appearance="Primary" Click="Apply_Click" MinWidth="84" />
        </Grid>
    </Grid>
</Window>
