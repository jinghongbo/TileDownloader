<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:TileDownloader.Controls"
    x:Class="TileDownloader.Views.NewDownloadPage">

    <Page.Resources>
        <!--  右栏卡片统一样式  -->
        <Style x:Key="SideCard" TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <!--  右栏分组标题  -->
        <Style x:Key="CardTitle" TargetType="ui:TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontTypography" Value="BodyStrong" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <!--  右栏说明文字  -->
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!--  左栏：自研地图控件 + 浮动工具条  -->
        <Border Grid.Column="0"
                CornerRadius="8"
                ClipToBounds="True"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid>
                <controls:TileMapControl x:Name="Map"
                                         Source="{Binding EffectiveSource}"
                                         SelectedRange="{Binding Range, Mode=TwoWay}"
                                         Zoom="12" />

                <!--  地图左上角浮动工具条（半透明磨砂卡片）  -->
                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="12"
                        CornerRadius="8"
                        Padding="6"
                        Background="#D41E1E26"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1">
                    <ui:Button Content="定位到选区"
                               Appearance="Secondary"
                               Icon="{ui:SymbolIcon MyLocation24}"
                               Click="LocateSelection_Click" />
                </Border>
            </Grid>
        </Border>

        <!--  右栏：极简三步流  -->
        <ScrollViewer Grid.Column="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!--  ① 选择来源  -->
                <ui:Card Style="{StaticResource SideCard}">
                    <StackPanel>
                        <ui:TextBlock Style="{StaticResource CardTitle}" Text="① 选择来源" />
                        <ComboBox Margin="0,12,0,0"
                                  ItemsSource="{Binding Sources}"
                                  SelectedItem="{Binding SelectedSource}"
                                  DisplayMemberPath="Name" />

                        <!--  需要密钥的来源：由用户填写（保存在本机，不写入来源配置）  -->
                        <StackPanel Margin="0,12,0,0"
                                    Visibility="{Binding HasKeyRequired, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource HintText}" Text="密钥（该来源需要，仅保存在本机）" />
                            <ui:TextBox Margin="0,6,0,0"
                                        PlaceholderText="请输入地图服务密钥"
                                        Text="{Binding RuntimeKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource HintText}"
                                   Margin="0,8,0,0"
                                   Text="在 Sources 目录添加 JSON 文件即可配置更多地图源（一源一文件）" />
                    </StackPanel>
                </ui:Card>

                <!--  ② 下载区域（支持省市区选择与地图框选）  -->
                <ui:Card Style="{StaticResource SideCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock Style="{StaticResource CardTitle}" Text="② 下载区域" />
                            <!--  状态图标：未选灰 / 已选绿  -->
                            <ui:SymbolIcon Grid.Column="1">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="Dismiss24" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasRange}" Value="True">
                                                <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                                <Setter Property="Foreground" Value="#6CCB7F" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>
                        </Grid>

                        <!--  模式切换：省市区选择 vs 地图手动框选  -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                            <RadioButton Content="省市区选择"
                                         GroupName="AreaModeGroup"
                                         IsChecked="{Binding IsRegionMode, Mode=TwoWay}"
                                         Margin="0,0,16,0" />
                            <RadioButton Content="地图手动框选"
                                         GroupName="AreaModeGroup"
                                         IsChecked="{Binding IsManualMode, Mode=TwoWay}" />
                        </StackPanel>

                        <!--  行政区划模式专属控件  -->
                        <StackPanel Visibility="{Binding IsRegionMode, Converter={StaticResource BoolToVis}}">
                            <!--  搜索检索框  -->
                            <ui:TextBox PlaceholderText="🔍 搜索省/市/区县（如：西湖区）"
                                        Text="{Binding SearchKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ClearButtonEnabled="True"
                                        Margin="0,0,0,6" />

                            <!--  搜索联想结果弹出列表卡片  -->
                            <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="4"
                                    Margin="0,0,0,8"
                                    MaxHeight="160"
                                    Visibility="{Binding IsSearchResultsOpen, Converter={StaticResource BoolToVis}}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SearchResults}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ui:Button HorizontalAlignment="Stretch"
                                                           HorizontalContentAlignment="Left"
                                                           Appearance="Transparent"
                                                           Padding="8,6"
                                                           Margin="0,1"
                                                           Command="{Binding DataContext.SelectSearchResultCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                           CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="Location24" Margin="0,0,6,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </ui:Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <!--  省 / 市 / 区 三级联动下拉框  -->
                            <TextBlock Style="{StaticResource HintText}" Text="省份 / 直辖市" Margin="0,2,0,4" />
                            <ComboBox ItemsSource="{Binding Provinces}"
                                      SelectedItem="{Binding SelectedProvince, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      Margin="0,0,0,8" />

                            <TextBlock Style="{StaticResource HintText}" Text="城市" Margin="0,2,0,4" />
                            <ComboBox ItemsSource="{Binding Cities}"
                                      SelectedItem="{Binding SelectedCity, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      Margin="0,0,0,8" />

                            <TextBlock Style="{StaticResource HintText}" Text="区 / 县" Margin="0,2,0,4" />
                            <ComboBox ItemsSource="{Binding Districts}"
                                      SelectedItem="{Binding SelectedDistrict, Mode=TwoWay}"
                                      DisplayMemberPath="Name"
                                      Margin="0,0,0,6" />
                        </StackPanel>

                        <!--  地图手动框选模式提示说明  -->
                        <StackPanel Visibility="{Binding IsManualMode, Converter={StaticResource BoolToVis}}" Margin="0,2,0,6">
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="在左侧地图上按住左键拖拽框选矩形范围，再次拖拽可重新选择" />
                        </StackPanel>

                        <!--  已选范围信息展示卡片（两种模式共用）  -->
                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,4,0,0"
                                Visibility="{Binding HasRange, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               Text="{Binding SelectedRegionText, FallbackValue='已选择区域'}"
                                               TextWrapping="Wrap" />
                                    <ui:Button Grid.Column="1"
                                               Appearance="Transparent"
                                               Icon="{ui:SymbolIcon Dismiss24}"
                                               ToolTip="清空选区"
                                               Padding="4"
                                               Command="{Binding ClearRangeCommand}" />
                                </Grid>
                                <TextBlock Style="{StaticResource HintText}"
                                           Margin="0,4,0,0"
                                           Text="{Binding SelectedRegionCoordinatesText}" />
                            </StackPanel>
                        </Border>

                        <!--  未选范围提示  -->
                        <TextBlock Margin="0,8,0,0"
                                   Text="尚未选择或框选下载范围"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Visibility="{Binding HasRange, Converter={StaticResource InverseBoolToVis}}" />

                        <!--  预估瓦片总量提示徽章卡片  -->
                        <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,8,0,0"
                                Visibility="{Binding HasRange, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Layer24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                                <TextBlock VerticalAlignment="Center">
                                    <Run Text="预估总量: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Run Text="{Binding EstimatedTileCountText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!--  定位地图快捷按钮  -->
                        <ui:Button Margin="0,8,0,0"
                                   Appearance="Secondary"
                                   Icon="{ui:SymbolIcon MyLocation24}"
                                   Content="定位地图至当前选区"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Center"
                                   Visibility="{Binding HasRange, Converter={StaticResource BoolToVis}}"
                                   Command="{Binding LocateRangeCommand}" />
                    </StackPanel>
                </ui:Card>

                <!--  高级选项（默认折叠）  -->
                <ui:Card Style="{StaticResource SideCard}" Padding="0">
                    <Expander IsExpanded="False"
                              HorizontalContentAlignment="Stretch"
                              Header="高级选项"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                        <StackPanel Margin="16,8,16,12">

                            <!--  层级范围  -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource HintText}" Text="最小层级（0–20）" />
                                    <ui:NumberBox Margin="0,6,0,0"
                                                  Value="{Binding MinLevel, Mode=TwoWay}"
                                                  Minimum="0" Maximum="20"
                                                  SmallChange="1"
                                                  ClearButtonEnabled="False" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource HintText}" Text="最大层级（0–20）" />
                                    <ui:NumberBox Margin="0,6,0,0"
                                                  Value="{Binding MaxLevel, Mode=TwoWay}"
                                                  Minimum="0" Maximum="20"
                                                  SmallChange="1"
                                                  ClearButtonEnabled="False" />
                                </StackPanel>
                            </Grid>

                            <!--  输出格式  -->
                            <TextBlock Style="{StaticResource HintText}" Margin="0,12,0,0" Text="输出格式" />
                            <ComboBox Margin="0,6,0,0"
                                      ItemsSource="{Binding Formats}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="FormatId"
                                      SelectedValue="{Binding FormatId, Mode=TwoWay}" />

                            <!--  输出路径  -->
                            <TextBlock Style="{StaticResource HintText}" Margin="0,12,0,0" Text="输出路径" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Text="{Binding OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            VerticalAlignment="Center" />
                                <ui:Button Grid.Column="1"
                                           Content="浏览"
                                           Margin="8,0,0,0"
                                           Command="{Binding BrowseOutputCommand}" />
                            </Grid>
                        </StackPanel>
                    </Expander>
                </ui:Card>

                <!--  主操作  -->
                <ui:Card Style="{StaticResource SideCard}">
                    <StackPanel>
                        <ui:Button Appearance="Primary"
                                   Content="{Binding StartDownloadButtonText, Mode=OneWay}"
                                   Icon="{ui:SymbolIcon ArrowDownload24}"
                                   MinHeight="44"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Center"
                                   Command="{Binding StartDownloadCommand}" />
                        <ui:Button Content="取消下载"
                                   Icon="{ui:SymbolIcon Dismiss24}"
                                   MinHeight="36"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Stretch"
                                   HorizontalContentAlignment="Center"
                                   Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"
                                   Command="{Binding CancelDownloadCommand}" />
                    </StackPanel>
                </ui:Card>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
