<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Class="TileDownloader.Views.SettingsPage">

    <Page.Resources>
        <!--  设置卡片统一样式  -->
        <Style x:Key="SettingCard" TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <!--  设置行：左侧标题+说明，右侧控件  -->
        <Style x:Key="SettingTitle" TargetType="ui:TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontTypography" Value="Body" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="SettingHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </Page.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <!--  居中限宽，阅读友好  -->
            <StackPanel MaxWidth="760" HorizontalAlignment="Center" Margin="16,8,16,16">

                <ui:TextBlock FontTypography="Title" Text="设置" />
                <ui:TextBlock FontTypography="Body" Opacity="0.7" Margin="0,2,0,16" Text="下载引擎参数与外观偏好，修改后即时生效" />

                <!--  下载  -->
                <ui:Card Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <ui:TextBlock FontTypography="Subtitle" Margin="0,0,0,8" Text="下载" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource SettingTitle}" Text="并发数" />
                                <TextBlock Style="{StaticResource SettingHint}" Margin="0,2,0,0"
                                           Text="同时下载瓦片的数量（1–4096），过高可能触发服务端限流" />
                            </StackPanel>
                            <ui:NumberBox Grid.Column="1"
                                          Width="140"
                                          VerticalAlignment="Center"
                                          Value="{Binding Concurrent, Mode=TwoWay}"
                                          Minimum="1" Maximum="4096"
                                          SmallChange="1"
                                          ClearButtonEnabled="False" />
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource SettingTitle}" Text="失败重试次数" />
                                <TextBlock Style="{StaticResource SettingHint}" Margin="0,2,0,0"
                                           Text="单张瓦片下载失败后的重试上限（0–10）" />
                            </StackPanel>
                            <ui:NumberBox Grid.Column="1"
                                          Width="140"
                                          VerticalAlignment="Center"
                                          Value="{Binding Retry, Mode=TwoWay}"
                                          Minimum="0" Maximum="10"
                                          SmallChange="1"
                                          ClearButtonEnabled="False" />
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource SettingTitle}" Text="下载使用代理" />
                                <TextBlock Style="{StaticResource SettingHint}" Margin="0,2,0,0"
                                           Text="默认直连，配合下方 Google Hosts 加速使用；开启后跟随系统代理（VPN/科学上网）" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1"
                                             VerticalAlignment="Center"
                                             IsChecked="{Binding UseProxy, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!--  Google Hosts 加速  -->
                <ui:Card Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <ui:TextBlock FontTypography="Subtitle" Margin="0,0,0,4" Text="Google Hosts 加速" />
                        <TextBlock Style="{StaticResource SettingHint}" Margin="0,4,0,12"
                                   Text="拉取 Google 官方 IP 段（goog.json 扣除 GCP 段）并结合 mt0-3 的 DNS 解析结果，直连逐个 IP 实际取一张瓦片，命中后连同该 IP 所在 /24 整段一起探测，凑够 4 个通过稳定性复测的可用 IP 后结束。写入本机 hosts 时按延迟顺序分给 mt0-3，加速卫星地图下载；需要本机可直连 Google（不走代理）" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource SettingTitle}" Text="可用 IP（至少 4 个）" />
                                <TextBlock Style="{StaticResource SettingHint}" Margin="0,2,0,0"
                                           Text="{Binding BestGoogleHostsText, Mode=OneWay}" />
                            </StackPanel>
                            <ui:Button Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Content="查找可用 IP"
                                        Command="{Binding ProbeGoogleHostsCommand}"
                                        Appearance="Primary" />
                        </Grid>

                        <!--  全量扫描进度（仅探测中显示）  -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                    Visibility="{Binding IsProbingGoogleHosts, Converter={StaticResource BoolToVisConverter}}">
                            <ProgressBar Width="200" Height="6"
                                         VerticalAlignment="Center"
                                         Maximum="100"
                                         Value="{Binding GoogleHostsProgressPercent, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource SettingHint}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding GoogleHostsProgressText, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:Button Content="复制 hosts 条目"
                                        Command="{Binding CopyHostsCommand}"
                                        Margin="0,0,8,0" />
                            <ui:Button Content="打开 hosts 文件"
                                        Command="{Binding OpenHostsCommand}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource SettingHint}"
                                   Text="{Binding GoogleHostsEntriesText, Mode=OneWay}"
                                   FontFamily="Consolas"
                                   Margin="0,0,0,8" />

                        <TextBlock Style="{StaticResource SettingHint}"
                                   Text="{Binding GoogleHostsMessage, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>

                <!--  外观  -->
                <ui:Card Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <ui:TextBlock FontTypography="Subtitle" Margin="0,0,0,8" Text="外观" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource SettingTitle}" Text="主题" />
                                <TextBlock Style="{StaticResource SettingHint}" Margin="0,2,0,0"
                                           Text="切换应用界面配色（深色 / 浅色 / 跟随系统）" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      Width="140"
                                      VerticalAlignment="Center"
                                      ItemsSource="{Binding ThemeModes}"
                                      SelectedItem="{Binding SelectedThemeMode, Mode=TwoWay}"
                                      DisplayMemberPath="Label" />
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!--  关于  -->
                <ui:Card Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <ui:TextBlock FontTypography="Subtitle" Margin="0,0,0,8" Text="关于" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource SettingTitle}" Text="通用瓦片地图下载工具" />
                                <TextBlock Style="{StaticResource SettingHint}" Margin="0,2,0,0"
                                           Text="批量下载 XYZ 瓦片地图 · 支持多文件 pak / 单文件 pak / MBTiles / 瓦片目录输出" />
                            </StackPanel>
                            <ui:TextBlock Grid.Column="1"
                                          FontTypography="Body"
                                          Opacity="0.7"
                                          VerticalAlignment="Center"
                                          Text="{Binding AppVersion, Mode=OneWay}" />
                        </Grid>

                        <!--  仓库与版权信息  -->
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <ui:SymbolIcon Symbol="Code24"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:HyperlinkButton Content="{Binding RepositoryText, Mode=OneWay}"
                                                NavigateUri="{Binding RepositoryUri, Mode=OneWay}"
                                                ToolTip="在浏览器中打开项目仓库" />
                            <TextBlock Style="{StaticResource SettingHint}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"
                                       Text="{Binding AppCopyright, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SettingHint}"
                                   Margin="24,4,0,0"
                                   Text="反馈问题或提交建议请前往仓库 Issues" />
                    </StackPanel>
                </ui:Card>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
