<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Class="TileDownloader.Views.SettingsPage">

    <Page.Resources>
        <!--  设置卡片统一样式  -->
        <Style x:Key="SettingCard" TargetType="ui:Card" BasedOn="{StaticResource {x:Type ui:Card}}">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="20" />
        </Style>
        <!--  设置行：左侧标题+说明，右侧控件  -->
        <Style x:Key="SettingTitle" TargetType="ui:TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontTypography" Value="Body" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="SettingHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </Page.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <!--  居中限宽，阅读友好  -->
            <StackPanel MaxWidth="760" HorizontalAlignment="Center" Margin="16,8,16,16">

                <ui:TextBlock FontTypography="Title" Text="设置" />
                <ui:TextBlock FontTypography="Body" Opacity="0.7" Margin="0,2,0,16" Text="下载引擎参数与外观偏好，修改后即时生效" />

                <!--  下载引擎设置  -->
                <ui:Card Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ui:SymbolIcon Symbol="ArrowDownload24" Foreground="{DynamicResource ThemeRunningBrush}" Margin="0,0,10,0" FontSize="18" VerticalAlignment="Center" />
                            <ui:TextBlock FontTypography="Subtitle" Text="下载引擎设置" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource SettingTitle}" Text="并发数" />
                                <TextBlock Style="{StaticResource SettingHint}" Margin="0,2,0,0"
                                           Text="同时下载瓦片的数量（1–4096），过高可能触发服务端限流" />
                            </StackPanel>
                            <ui:NumberBox Grid.Column="1"
                                          Width="140"
                                          VerticalAlignment="Center"
                                          Value="{Binding Concurrent, Mode=TwoWay}"
                                          Minimum="1" Maximum="4096"
                                          SmallChange="1"
                                          ClearButtonEnabled="False" />
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource SettingTitle}" Text="失败重试次数" />
                                <TextBlock Style="{StaticResource SettingHint}" Margin="0,2,0,0"
                                           Text="单张瓦片下载失败后的重试上限（0–10）" />
                            </StackPanel>
                            <ui:NumberBox Grid.Column="1"
                                          Width="140"
                                          VerticalAlignment="Center"
                                          Value="{Binding Retry, Mode=TwoWay}"
                                          Minimum="0" Maximum="10"
                                          SmallChange="1"
                                          ClearButtonEnabled="False" />
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource SettingTitle}" Text="下载使用代理" />
                                <TextBlock Style="{StaticResource SettingHint}" Margin="0,2,0,0"
                                           Text="默认直连，配合下方 Google Hosts 加速使用；开启后跟随系统代理（VPN/科学上网）" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1"
                                             VerticalAlignment="Center"
                                             IsChecked="{Binding UseProxy, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!--  Google Hosts 网络加速  -->
                <ui:Card Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Symbol="Globe24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0" FontSize="18" VerticalAlignment="Center" />
                            <ui:TextBlock FontTypography="Subtitle" Text="Google Hosts 网络加速" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SettingHint}" Margin="0,4,0,12"
                                   Text="内置网络加速引擎：当不开启系统代理时，程序自动通过测速最优的 IP 直连请求 Google 卫星瓦片，无需修改本地 hosts 文件，安全且免管理员权限。" />

                        <!--  当前加速状态与一键探测  -->
                        <Border Margin="0,0,0,10" Padding="14,10" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Flash24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0" FontSize="14" VerticalAlignment="Center" />
                                        <TextBlock Text="当前直连加速节点" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource SettingHint}" Margin="0,4,0,0"
                                               Text="{Binding FastestIpText, Mode=OneWay}" />
                                </StackPanel>
                                <ui:Button Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Content="测速并应用最快 IP"
                                           Icon="{ui:SymbolIcon GlobeSearch24}"
                                           Command="{Binding ProbeGoogleHostsCommand}"
                                           Appearance="Primary" />
                            </Grid>
                        </Border>

                        <!--  探测进度条（仅探测中显示）  -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                    Visibility="{Binding IsProbingGoogleHosts, Converter={StaticResource BoolToVisConverter}}">
                            <ProgressBar Width="200" Height="6"
                                         VerticalAlignment="Center"
                                         Maximum="100"
                                         Value="{Binding GoogleHostsProgressPercent, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource SettingHint}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding GoogleHostsProgressText, Mode=OneWay}" />
                        </StackPanel>

                        <!--  探测结果与状态提示  -->
                        <TextBlock Style="{StaticResource SettingHint}"
                                   Text="{Binding GoogleHostsMessage, Mode=OneWay}"
                                   Margin="0,0,0,8"
                                   TextWrapping="Wrap" />

                        <!--  折叠面板：可选联动系统 hosts 文件  -->
                        <Expander IsExpanded="False"
                                  HorizontalContentAlignment="Stretch"
                                  Header="高级选项：导出条目至系统 hosts（供外部浏览器或第三方 GIS 软件使用）"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Margin="0,4,0,0">
                            <StackPanel Margin="12,10,12,6">
                                <TextBlock Style="{StaticResource SettingHint}" Margin="0,0,0,8"
                                           Text="本程序内部已全自动采用最快 IP 直连，无需配置系统 hosts。若您希望外部浏览器或其他 GIS 工具也能直连 Google 卫星地图，可将探测出的条目复制写入 hosts：" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ui:Button Content="复制 hosts 条目"
                                               Icon="{ui:SymbolIcon Copy24}"
                                               Command="{Binding CopyHostsCommand}"
                                               Margin="0,0,8,0" />
                                    <ui:Button Content="打开 hosts 文件"
                                               Icon="{ui:SymbolIcon DocumentEdit24}"
                                               Command="{Binding OpenHostsCommand}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource SettingHint}"
                                           Text="{Binding GoogleHostsEntriesText, Mode=OneWay}"
                                           FontFamily="Consolas"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ui:Card>

                <!--  外观与个性化  -->
                <ui:Card Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <ui:SymbolIcon Symbol="DarkTheme24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0" FontSize="18" VerticalAlignment="Center" />
                            <ui:TextBlock FontTypography="Subtitle" Text="外观与主题" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <ui:TextBlock Style="{StaticResource SettingTitle}" Text="应用主题模式" />
                                <TextBlock Style="{StaticResource SettingHint}" Margin="0,2,0,0"
                                           Text="切换应用界面色彩风格（深色模式 / 浅色模式 / 跟随系统主题），即时生效" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      Width="140"
                                      VerticalAlignment="Center"
                                      ItemsSource="{Binding ThemeModes}"
                                      SelectedItem="{Binding SelectedThemeMode, Mode=TwoWay}"
                                      DisplayMemberPath="Label" />
                        </Grid>
                    </StackPanel>
                </ui:Card>

                <!--  关于软件与开源项目  -->
                <ui:Card Style="{StaticResource SettingCard}">
                    <StackPanel>
                        <!--  应用品牌信息  -->
                        <StackPanel Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:TextBlock FontTypography="Subtitle" FontWeight="Bold" Text="瓦片地图下载工具" VerticalAlignment="Center" />
                                <Border Background="{DynamicResource ThemeStepBadgeBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AppVersion, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SettingHint}" Margin="0,4,0,0"
                                       Text="批量下载 XYZ 瓦片地图 · 支持多文件 pak / 单文件 pak / MBTiles / 瓦片目录输出" />
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,0,0,16" />

                        <!--  仓库与版权信息  -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <ui:SymbolIcon Symbol="Code24"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <ui:HyperlinkButton Content="{Binding RepositoryText, Mode=OneWay}"
                                                NavigateUri="{Binding RepositoryUri, Mode=OneWay}"
                                                ToolTip="在浏览器中打开项目仓库" />
                            <TextBlock Style="{StaticResource SettingHint}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"
                                       Text="{Binding AppCopyright, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SettingHint}"
                                   Margin="24,6,0,0"
                                   Text="💡 如有疑问、功能建议或缺陷反馈，欢迎前往项目 GitHub 仓库提交 Issue" />
                    </StackPanel>
                </ui:Card>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
