<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:models="clr-namespace:TileDownloader.Models"
    x:Class="TileDownloader.Views.TasksPage">

    <Page.Resources>
        <!--  小标签样式（来源/格式）  -->
        <Style x:Key="TagBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="TagText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <!--  任务卡片模板  -->
        <DataTemplate x:Key="TaskCardTemplate" DataType="{x:Type models:TaskItem}">
            <ui:Card Margin="0,0,0,12" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  行 0：名称 + 来源/格式标签 + 状态徽标  -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <ui:TextBlock FontTypography="BodyStrong"
                                          Text="{Binding Name, Mode=OneWay}"
                                          TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <!--  来源标签（无来源时隐藏）  -->
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource TagBorder}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SourceLabel, Mode=OneWay}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Style="{StaticResource TagText}" Text="{Binding SourceLabel, Mode=OneWay}" />
                                </Border>
                                <!--  格式标签（无请求时隐藏）  -->
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource TagBorder}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FormatLabel, Mode=OneWay}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Style="{StaticResource TagText}" Text="{Binding FormatLabel, Mode=OneWay}" />
                                </Border>
                            </StackPanel>
                            <!--  任务详情：层级范围 + 输出路径（无请求时隐藏）  -->
                            <TextBlock Margin="0,6,0,0"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Text="{Binding DetailText, Mode=OneWay}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DetailText, Mode=OneWay}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!--  状态徽标：自适应药丸胶囊（深浅主题高对比度）  -->
                        <Border Grid.Column="1"
                                CornerRadius="12"
                                Padding="10,4"
                                Background="{Binding StateBackgroundBrush, Mode=OneWay}"
                                VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:ProgressRing Width="14" Height="14"
                                                 IsIndeterminate="True"
                                                 Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Visibility="{Binding IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                <ui:SymbolIcon Symbol="{Binding StateIcon, Mode=OneWay}"
                                               Foreground="{Binding StateBrush, Mode=OneWay}"
                                               FontSize="14"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsRunning, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}" />
                                <TextBlock Text="{Binding StateText, Mode=OneWay}"
                                           Foreground="{Binding StateBrush, Mode=OneWay}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!--  行 1：进行中 = 总进度条 + 统计 + 层级明细；非进行中 = 最终状态摘要  -->
                    <StackPanel Grid.Row="1" Margin="0,12,0,0"
                                Visibility="{Binding IsRunning, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar Maximum="100"
                                         Value="{Binding Progress, Mode=OneWay}"
                                         Height="8"
                                         VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Progress, Mode=OneWay, StringFormat={}{0:F1}%}"
                                       Margin="12,0,0,0"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="已完成 " /><Run Text="{Binding Completed, Mode=OneWay, StringFormat={}{0:N0}}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /><Run Text=" / " /><Run Text="{Binding Total, Mode=OneWay, StringFormat={}{0:N0}}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Run Text="  ·  ⚡ 速度: " /><Run Text="{Binding Speed, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Run Text="  ·  ⏱ 剩余: " /><Run Text="{Binding Remaining, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </TextBlock>

                        <!--  分层级进度明细  -->
                        <ItemsControl ItemsSource="{Binding Levels, Mode=OneWay}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Level, Mode=OneWay, StringFormat=层级 {0}}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <ProgressBar Grid.Column="1"
                                                     Maximum="100"
                                                     Value="{Binding Progress, Mode=OneWay}"
                                                     Height="6"
                                                     VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <Run Text="{Binding Completed, Mode=OneWay, StringFormat={}{0:N0}}" /><Run Text="/" /><Run Text="{Binding Total, Mode=OneWay, StringFormat={}{0:N0}}" />
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!--  非进行中：最终状态摘要（完成数量 + 结束时间）  -->
                    <TextBlock Grid.Row="1" Margin="0,12,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding IsRunning, Mode=OneWay, Converter={StaticResource InverseBoolToVis}}">
                        <Run Text="共 " /><Run Text="{Binding Total, Mode=OneWay, StringFormat={}{0:N0}}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" /><Run Text=" 瓦片 · 已完成 " /><Run Text="{Binding Completed, Mode=OneWay, StringFormat={}{0:N0}}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Run Text=" · " /><Run Text="{Binding FinishedText, Mode=OneWay}" />
                    </TextBlock>

                    <!--  行 2：错误信息（自适应主题高对比度容器）  -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource ThemeDangerBackgroundBrush}"
                            BorderBrush="{DynamicResource ThemeDangerBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,6"
                            Margin="0,10,0,0"
                            Visibility="{Binding HasError, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ErrorCircle24" Foreground="{DynamicResource ThemeDangerBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Error, Mode=OneWay}"
                                       Foreground="{DynamicResource ThemeDangerBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!--  行 3：操作按钮（按状态显隐：打开位置 / 开始·继续·重试 / 暂停 / 取消 / 删除）  -->
                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,12,0,0">
                        <ui:Button Content="打开位置"
                                   Icon="{ui:SymbolIcon FolderOpen24}"
                                   Margin="0,0,8,0"
                                   Visibility="{Binding CanOpenOutput, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                   Command="{Binding DataContext.OpenOutputCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   CommandParameter="{Binding}" />
                        <ui:Button Content="{Binding PrimaryActionText, Mode=OneWay}"
                                   Icon="{ui:SymbolIcon ArrowClockwise24}"
                                   Appearance="Primary"
                                   Margin="0,0,8,0"
                                   Visibility="{Binding CanContinue, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                   Command="{Binding DataContext.ContinueCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   CommandParameter="{Binding}" />
                        <ui:Button Content="暂停"
                                   Icon="{ui:SymbolIcon Pause24}"
                                   Margin="0,0,8,0"
                                   Visibility="{Binding CanPause, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                   Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   CommandParameter="{Binding}" />
                        <ui:Button Content="取消"
                                   Icon="{ui:SymbolIcon Dismiss24}"
                                   Margin="0,0,8,0"
                                   Visibility="{Binding CanCancel, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                   Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   CommandParameter="{Binding}" />
                        <ui:Button Content="删除"
                                   Icon="{ui:SymbolIcon Delete24}"
                                   Visibility="{Binding CanRemove, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                   Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </ui:Card>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="16,8,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  顶部工具行：标题 + 仪表盘指标 + 清除已完成  -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                <ui:TextBlock FontTypography="Title" Text="任务中心" />
                <ui:TextBlock FontTypography="Body" Opacity="0.7" Margin="0,2,0,0" Text="实时查看与管理瓦片下载任务进度" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,6"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="ArrowDownload24" Foreground="{DynamicResource ThemeRunningBrush}" Margin="0,0,6,0" />
                        <TextBlock VerticalAlignment="Center">
                            <Run Text="进行中: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Run Text="{Binding RunningCount, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource ThemeRunningBrush}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="DataPie24" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,6,0" />
                        <TextBlock VerticalAlignment="Center">
                            <Run Text="总进度: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Run Text="{Binding OverallProgress, Mode=OneWay, StringFormat={}{0:F1}%}" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>

            <ui:Button Grid.Column="2"
                       Content="清除已完成"
                       Icon="{ui:SymbolIcon Delete24}"
                       Appearance="Secondary"
                       VerticalAlignment="Center"
                       IsEnabled="{Binding HasCompleted, Mode=OneWay}"
                       Command="{Binding ClearCompletedCommand}" />
        </Grid>

        <!--  任务卡片列表  -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Tasks}"
                          ItemTemplate="{StaticResource TaskCardTemplate}" />
        </ScrollViewer>

        <!--  空状态提示  -->
        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Tasks.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="44" Opacity="0.35" HorizontalAlignment="Center" />
            <ui:TextBlock Text="暂无下载任务"
                          FontTypography="Subtitle"
                          Margin="0,12,0,0"
                          HorizontalAlignment="Center" />
            <TextBlock Text="在「新建下载」页选择地图来源并框选范围即可开始"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,6,0,0"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
